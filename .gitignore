# ============================================================
#  小楚君机械手 · FreeRTOS 改造版
#  .gitignore
# ============================================================

# ---------- 编译产物 ----------
build/
*.bin
*.elf
*.hex
*.map
*.o
*.d

# ---------- 可执行文件 / 压缩包（体积大，不入库）----------
*.exe
*.msi
*.zip
*.rar
*.7z
*.apk

# ---------- 3D 模型（23MB，来自原项目，不入库）----------
*.stl
*.step
*.stp
*.3mf

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.code-workspace
*.uvprojx
*.uvoptx
# 注意：*.spec 是 PyInstaller 打包脚本，属于源码，不要忽略

# ---------- 备份 / 日志（不要污染仓库）----------
*.bak
*.before-*
*.log

# ---------- 原作者资产（版权属原作者，不随本仓库分发）----------
# 3D 模型、接线文档、原始固件、原作者上位机程序均不在本仓库分发。
# 本仓库只存放本人改造后的代码。需要原件请前往原作者渠道获取。
小楚君机械手开源/小楚君机械手接线文档.docx
小楚君机械手开源/主控代码/sketch_26_7_4/
小楚君机械手开源/主控代码/备份代码.txt
上位机/

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 工具生成的临时目录 ----------
.workbuddy/

# ---------- 私人求职资料 / 个人规划（不要放进公开仓库）----------

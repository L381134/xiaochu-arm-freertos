// ========================================================================
//  实验 01：让两个任务"同时"跑
// ------------------------------------------------------------------------
//  这个文件不接任何硬件，只用串口。烧进去看串口监视器（115200）就行。
//
//  你会看到 A、B、loop 三种行交错出现 —— 这就是"多任务"。
//  但注意：ESP32-C3 只有一个核，同一时刻只有一个任务在跑。
//  之所以看起来像同时，是因为每个任务在 vTaskDelay 时会主动让出 CPU，
//  调度器立刻换下一个任务上去。这个"主动让出"就叫【阻塞】。
//
//  对照你原来的项目：loop() 里那个 delay(10) 就是同一个道理，
//  所以原版其实也没卡死 CPU —— 这一点很多教程讲错了。
// ========================================================================

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

// 任务的"身份证"，暂时用不上，但养成习惯先留着
TaskHandle_t handleA = nullptr;
TaskHandle_t handleB = nullptr;

// ------------------------------------------------------------------------
//  任务 A：每 500ms 打印一次
//  参数 pv 是创建任务时传进来的指针，这个实验不用，写 (void)pv 消警告
// ------------------------------------------------------------------------
void taskA(void* pv) {
  (void)pv;
  int count = 0;
  for (;;) {                                  // 任务函数必须是死循环！
    Serial.printf("[A] 第 %d 次\n", ++count);
    vTaskDelay(pdMS_TO_TICKS(500));           // 睡 500ms，期间把 CPU 让给别人
  }
}

// ------------------------------------------------------------------------
//  任务 B：每 1300ms 打印一次（故意用奇怪的周期，方便你数交错规律）
// ------------------------------------------------------------------------
void taskB(void* pv) {
  (void)pv;
  int count = 0;
  for (;;) {
    Serial.printf("    [B] 第 %d 次\n", ++count);
    vTaskDelay(pdMS_TO_TICKS(1300));
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n=== 实验 01 开始 ===");

  // xTaskCreate 六个参数，从左到右：
  //   1. 任务函数名
  //   2. 任务名（只是给人看的，调试器里显示）
  //   3. 栈大小，单位是【字节】！不是字！4096 就是 4KB
  //   4. 传给任务的参数，没有就写 nullptr
  //   5. 优先级，0~24，数字越大越优先，空闲任务是 0
  //   6. 任务句柄的地址，不想要就写 nullptr
  xTaskCreate(taskA, "taskA", 4096, nullptr, 2, &handleA);
  xTaskCreate(taskB, "taskB", 4096, nullptr, 2, &handleB);

  Serial.println("两个任务已创建");
}

void loop() {
  // loop 自己也是一个任务（loopTask，优先级 1）
  Serial.println("        [loop] 我还活着");
  vTaskDelay(pdMS_TO_TICKS(2000));
}

// ========================================================================
//  烧录后你要观察的三件事
// ------------------------------------------------------------------------
//  1. A 和 B 的行是交错出现的 —— 两个任务在轮流用 CPU
//  2. loop 每 2 秒插一句，说明它没被 A/B 饿死
//  3. 把 A 的 500 改成 100，A 会变得更密，但 B 和 loop 仍然按自己的节奏走
//     → 这就是"一个任务变忙不会拖慢别人"，也是你改造机械手的核心理由
//
//  动手改一改（每改一次重新烧录，看现象）：
//    a) 把 xTaskCreate 里 B 的优先级从 2 改成 3，观察谁先打印
//    b) 把 vTaskDelay 改成 delay，现象其实一样（因为 delay 内部就是 vTaskDelay）
//    c) 把栈从 4096 改成 1024，看会不会重启 —— 大概率会，这就是"栈不够"
// ========================================================================
